FMP_API_KEY=your_fmp_api_key
GEMINI_API_KEY=your_gemini_api_key
FINNHUB_API_KEY=your_finnhub_api_key
# Google sign-in (Auth.js). Generate the secret with `openssl rand -base64 33`.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Needed with `next start` unless the app runs on Vercel; or set AUTH_URL to the public URL.
AUTH_TRUST_HOST=true
# Postgres for favorites (Neon, Supabase or any Postgres). Then run `npm run db:setup`.
DATABASE_URL=
# Optional: how the app identifies itself to the SEC (filings, statements fallback, the AI portfolio), e.g. "StockPilot you@example.com".
# SEC_USER_AGENT=
# Alpha Vantage for earnings call transcripts (free key: 25 requests a day).
ALPHAVANTAGE_API_KEY=
# Optional: Tiingo for daily prices when FMP's plan doesn't cover a company or hits its limit (free key).
TIINGO_API_KEY=
# Telegram notifications for favorites (bot from @BotFather). See docs/notifications.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Optional: an Alpaca paper trading account for the AI portfolio (free). See docs/ai-portfolio.md.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# The weekly job places orders only when this is true; otherwise it records the moves.
# AI_PORTFOLIO_TRADING_ENABLED=true
# Optional: FRED's API for the AI portfolio's 10-year yield and CPI (free key: https://fred.stlouisfed.org/docs/api/api_key.html).
# Without it they come from FRED's public CSV. TradingAgents uses it too.
# FRED_API_KEY=
# Optional: TradingAgents' reviews of portfolios (agents/review.py), with a Gemini key from its own Google project.
# See docs/portfolio-reviews.md.
AGENTS_GOOGLE_API_KEY=
# Optional: the app's public address, so notifications link to its pages.
# APP_URL=
# Optional: override the default Gemini model (the AI chat needs one with function calling)
# GEMINI_MODEL=gemini-3.5-flash-lite
