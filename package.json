{
  "name": "stock-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "symbols:update": "node scripts/update-symbols.mjs",
    "notify:earnings": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/notify.ts earnings",
    "notify:transcripts": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/notify.ts transcripts"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.7"
  }
}
